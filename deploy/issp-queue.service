[Unit]
Description=ISSP site queue worker (Laravel)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/php __APP_DIR__/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
